{
  "solidity.compileUsingRemoteVersion": "v0.8.28",
  "solidity.packageDefaultDependenciesContractsDirectory": "contracts/src",
  "solidity.packageDefaultDependenciesDirectory": "contracts/lib",
  "solidity.remappings": [
    "forge-std/=contracts/lib/forge-std/src/",
    "src/=contracts/src/",
    "lib/=contracts/lib/",
    "lib/forge-std/src/=contracts/lib/forge-std/src/"
  ],
  "solidity.remappingsUnix": [
    "forge-std/=contracts/lib/forge-std/src/",
    "src/=contracts/src/",
    "lib/=contracts/lib/",
    "lib/forge-std/src/=contracts/lib/forge-std/src/"
  ]
}
